graph LR
    subgraph Platform["Learning Platform"]
        LMS[Learning Management<br/>Course Structure]
        CONTENT[Course Content<br/>Video + Text]
    end

    subgraph Delivery["Content Delivery"]
        VIDEO[Video Streaming<br/>CDN + HLS]
        INTERACTIVE[Interactive Exercises<br/>Code Challenges]
        QUIZZES[Assessments<br/>Quiz Engine]
    end

    subgraph Progress["Progress Tracking"]
        COMPLETION[Completion Tracking<br/>User Progress]
        CERTIFICATES[Certificates<br/>PDF Generation]
        ANALYTICS[Analytics Dashboard<br/>Learning Insights]
