# Server-side only. Read by the API handlers in server/, never sent to the browser.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=
# Contact form delivery through Resend. Without these the contact endpoint answers 503.
RESEND_API_KEY=
CONTACT_FROM="Portfolio <portfolio@example.com>"
CONTACT_TO=you@example.com

# Browser-side, optional. A PageSpeed Insights key raises the anonymous quota for the Release tab.
VITE_PAGESPEED_API_KEY=
