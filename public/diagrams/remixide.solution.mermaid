graph TB
    subgraph "Electron Application"
        Main[Main Process - index.js]
        Renderer[Renderer Process]
        BrowserWindow[BrowserWindow Instance]
        
        Main --> |"Creates"| BrowserWindow
        BrowserWindow --> |"Contains"| Renderer
        Renderer --> |"Loads"| RemixWeb
    end
    
    subgraph "Platform Integration"
        Windows[Windows Installer]
        MacOS[macOS App Bundle]
        Linux[Linux Packages]
        
        Windows --> |"Squirrel.Windows"| AutoUpdate
        MacOS --> |".app bundle"| DockIntegration
        Linux --> |".deb/.rpm"| PackageManager
    end
    
    subgraph "Build Pipeline"
        ElectronForge[Electron Forge]
        Makers[Platform Makers]
        Assets[Icon Assets]
        
        ElectronForge --> |"Packages"| Makers
        Assets --> |"Embedded in"| Makers
        Makers --> |"Generates"| Installers
    end
    
    subgraph "Runtime Components"
        RemixWeb[Remix IDE Web]
        DevTools[Chrome DevTools]
        NodeAPIs[Node.js APIs]
        
        RemixWeb --> |"HTTP"| Ethereum
        DevTools --> |"Debug"| SmartContracts
        NodeAPIs --> |"File System"| LocalProjects
    end
    
    subgraph "Distribution"
        GitHub[GitHub Releases]
        AutoUpdate[Auto Update]
        Installers[Native Installers]
        
        GitHub --> |"Hosts"| Installers
        AutoUpdate --> |"Downloads"| GitHub
        Installers --> |"Install"| ElectronApp
    end
    
    Ethereum[Ethereum Network]
    SmartContracts[Smart Contracts]
    LocalProjects[Local Projects]
    ElectronApp[Installed App]
    DockIntegration[Dock Integration]
    PackageManager[Package Managers]
    
    style Main fill:#dce4ff
    style RemixWeb fill:#fff4d4
    style ElectronForge fill:#e1f5e1
    style BrowserWindow fill:#ffd4d4
